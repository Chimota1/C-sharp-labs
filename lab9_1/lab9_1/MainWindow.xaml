<Window x:Class="lab9_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab9_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="36" Margin="30">
            List
        </TextBlock>
        <StackPanel Grid.Row="1" Orientation="Horizontal " HorizontalAlignment="Center" Margin="10">
            <TextBox Name="InputBox" Margin="10" Width="200" Height="30"/>
            <Button Name="AddBtn" Margin="10" Width="100" Height="30" Content="Add Number" Click="Add_Click"/>
        </StackPanel>
        <Button Name="ChangeBtn" Grid.Row="2" Height="50" Width="300" Content="Change List" FontSize="30" Click="Change_Click"/>
        <TextBlock Name="OutputBlock" Grid.Row="3"></TextBlock>
    </Grid>
</Window>
